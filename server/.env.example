DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

SUPABASE_URL=
SUPABASE_KEY=

SECRET_ENCRYPTION_KEY=

ASYNCPG_COMMAND_TIMEOUT=60.0
DB_KEEPALIVES=1
DB_KEEPALIVES_IDLE=30 
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=3  
DB_TCP_KEEPALIVES_IDLE=300
DB_TCP_KEEPALIVES_INTERVAL=30
DB_TCP_KEEPALIVES_COUNT=3

# --- LangGraph / Conflow agents (langgraph dev) ---
# mock: deterministic local stub (default).
# llm: OpenAI, ollama: local Ollama server, vllm: OpenAI-compatible vLLM endpoint.
CONFLOW_AGENT_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen2.5:7b
VLLM_API_KEY=EMPTY
# LangSmith tracing (optional; LANGSMITH_API_KEY required)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false

# FastAPI JWT (make dev / make local)
SIGNING_KEY=

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
